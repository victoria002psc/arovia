# Public site URL (optional; used for canonicals/metadata)
NEXT_PUBLIC_SITE_URL=

# --- Node.js local API (`src/app/api/contact` + mailer) ---
CONTACT_EMAIL=arovia22@gmail.com
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_KEY=
EMAIL_FROM=Arovia Group <hello@your-verified-domain.com>

# SMTP only works on Node.js hosts — NOT on Cloudflare Pages Functions
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Cloudflare Pages Function secrets (dashboard only; do not commit) ---
# Set these in Cloudflare Pages → Settings → Environment variables (encrypt secrets):
#   EMAIL_PROVIDER_KEY  = Resend API key
#   CONTACT_EMAIL       = inbox for enquiries
#   EMAIL_FROM          = verified Resend "from" address
